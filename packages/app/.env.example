# Universo Platformo Vue — Frontend Environment
#
# Copy this file to .env.local and adjust values for your environment.
# The frontend NEVER connects to Supabase directly.
# All API calls go to the Django backend, which handles Supabase internally.

# URL of the Django backend API server.
# Used by Vite dev-server proxy only; in production configure your web server.
VITE_API_TARGET=http://localhost:8000
